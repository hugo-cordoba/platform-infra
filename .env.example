# Copia este archivo a .env y rellena los valores reales.
# .env NUNCA se commitea (ver .gitignore).

# Email para el registro de certificados Let's Encrypt (Traefik lo usa
# para avisos de caducidad, no es público en ningún sitio).
ACME_EMAIL=tu-email@tudominio.com

# Credenciales de acceso a pgAdmin. Cámbialas por unas fuertes y únicas;
# no se accede por Internet pero son la puerta a las BD de todos los clientes.
PGADMIN_EMAIL=admin@tudominio.com
PGADMIN_PASSWORD=cambia-esto-por-algo-fuerte
